<?xml version="1.0" encoding="utf-8"?>
<!-- Player buttons: a ripple on touch and a clear frame when focused with a remote. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#40FFFFFF">
    <item>
        <selector>
            <item android:state_focused="true">
                <shape>
                    <solid android:color="#40FFFFFF" />
                    <stroke android:width="2dp" android:color="@color/accent" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item>
                <color android:color="@android:color/transparent" />
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask">
        <shape>
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</ripple>
