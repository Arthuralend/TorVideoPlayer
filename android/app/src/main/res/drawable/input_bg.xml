<?xml version="1.0" encoding="utf-8"?>
<!-- List rows (recents, torrent files, file browser). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFFFFF">
    <item>
        <selector>
            <item android:state_focused="true">
                <shape>
                    <solid android:color="#34343B" />
                    <stroke android:width="2dp" android:color="@color/accent" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/panel" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
