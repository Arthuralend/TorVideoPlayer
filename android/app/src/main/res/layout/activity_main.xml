<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Player: always present underneath so the video surface survives screen switches. -->
    <FrameLayout
        android:id="@+id/playerPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000">

        <org.videolan.libvlc.util.VLCVideoLayout
            android:id="@+id/videoLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Our own subtitle overlay (two tracks at once). -->
        <FrameLayout
            android:id="@+id/subtitleLayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">
            <TextView
                android:id="@+id/topSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:shadowColor="#000000"
                android:shadowRadius="4"
                android:shadowDx="0"
                android:shadowDy="1"
                android:textStyle="bold"
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/bottomSubs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginBottom="24dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/stackedSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:shadowColor="#000000"
                    android:shadowRadius="4"
                    android:shadowDy="1"
                    android:textStyle="bold"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/primarySub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:shadowColor="#000000"
                    android:shadowRadius="4"
                    android:shadowDy="1"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>

        <!-- Receives taps / double taps over the video. -->
        <View
            android:id="@+id/touchLayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/bufferingBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/badge_bg"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">
            <ProgressBar
                android:id="@+id/bufferingSpinner"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:indeterminateTint="@color/accent" />
            <TextView
                android:id="@+id/bufferingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Буферизация…"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/bufferingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#CCFFFFFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/osd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="72dp"
            android:background="@drawable/badge_bg"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Controls -->
        <FrameLayout
            android:id="@+id/controls"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:background="@drawable/top_gradient"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="20dp">
                <ImageButton
                    android:id="@+id/btnClose"
                    style="@style/IconButton"
                    android:contentDescription="Назад"
                    android:src="@drawable/ic_back" />
                <TextView
                    android:id="@+id/playerTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="#D0FFFFFF"
                    android:textSize="12sp" />
                <ImageButton
                    android:id="@+id/btnRotate"
                    style="@style/IconButton"
                    android:contentDescription="Повернуть экран"
                    android:src="@drawable/ic_rotate" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/btnBack10"
                    style="@style/TextButton"
                    android:layout_height="64dp"
                    android:minWidth="64dp"
                    android:text="−10"
                    android:textSize="18sp" />
                <ImageButton
                    android:id="@+id/btnPlay"
                    style="@style/IconButton"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:padding="16dp"
                    android:contentDescription="Пауза"
                    android:src="@drawable/ic_pause" />
                <TextView
                    android:id="@+id/btnForward10"
                    style="@style/TextButton"
                    android:layout_height="64dp"
                    android:minWidth="64dp"
                    android:text="+10"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bottomBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@drawable/bottom_gradient"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingTop="24dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/timeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="52dp"
                        android:gravity="end"
                        android:text="0:00"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                    <SeekBar
                        android:id="@+id/seekBar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="10000"
                        android:progressTint="@color/accent"
                        android:thumbTint="@color/accent" />
                    <TextView
                        android:id="@+id/lengthText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="52dp"
                        android:text="0:00"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical|end"
                    android:orientation="horizontal">
                    <ImageButton
                        android:id="@+id/btnNext"
                        style="@style/IconButton"
                        android:contentDescription="Следующий файл"
                        android:src="@drawable/ic_next"
                        android:visibility="gone" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />
                    <LinearLayout
                        android:id="@+id/btnSubs"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_cc"
                            android:tint="#FFFFFF" />
                        <TextView
                            android:id="@+id/subsSummary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Выкл"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />
                    </LinearLayout>
                    <ImageButton
                        android:id="@+id/btnAudio"
                        style="@style/IconButton"
                        android:contentDescription="Звуковая дорожка"
                        android:src="@drawable/ic_audio" />
                    <TextView
                        android:id="@+id/btnRate"
                        style="@style/TextButton"
                        android:text="1×" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <!-- File list -->
    <LinearLayout
        android:id="@+id/filesPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">
        <Button
            android:id="@+id/btnFilesBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹  Назад" />
        <TextView
            android:id="@+id/torrentName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/fg"
            android:textSize="20sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/filesSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:textColor="@color/fg_dim" />
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:id="@+id/filesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- Loading -->
    <LinearLayout
        android:id="@+id/loadingPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">
        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/accent" />
        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/fg"
            android:textSize="18sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Поиск пиров может занять до минуты для редких раздач"
            android:textColor="@color/fg_dim" />
        <Button
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Отмена" />
    </LinearLayout>

    <!-- Home -->
    <ScrollView
        android:id="@+id/homePanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">
            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginTop="24dp"
                android:src="@drawable/app_logo" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="MediaPlayer"
                android:textColor="@color/fg"
                android:textSize="28sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Смотрите торренты онлайн — без ожидания полной загрузки"
                android:textColor="@color/fg_dim" />
            <EditText
                android:id="@+id/input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/panel_bg"
                android:hint="magnet:?xt=…, ссылка на .torrent, info-hash"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="3"
                android:padding="14dp"
                android:textColor="@color/fg"
                android:textColorHint="#6A6A72"
                android:textSize="14sp" />
            <Button
                android:id="@+id/btnWatch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/accent"
                android:text="Смотреть"
                android:textColor="#1A1A1A"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btnOpenFile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Файл…" />
                <Button
                    android:id="@+id/btnPaste"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Вставить" />
                <Button
                    android:id="@+id/btnSettings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Настройки" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Magnet-ссылки из браузера тоже открываются в MediaPlayer"
                android:textColor="@color/fg_dim"
                android:textSize="12sp" />
            <LinearLayout
                android:id="@+id/recentsBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Недавние"
                        android:textColor="@color/fg"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <Button
                        android:id="@+id/btnClearRecents"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Очистить"
                        android:textColor="@color/accent" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/recentsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
