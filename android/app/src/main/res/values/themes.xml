<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorAccent">#FF8A1E</item>
        <item name="android:colorPrimary">#161618</item>
        <item name="android:colorPrimaryDark">#000000</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">#161618</item>
        <item name="android:navigationBarColor">#161618</item>
        <item name="android:textColorPrimary">#EDEDED</item>
        <item name="android:textColorSecondary">#9A9AA2</item>
    </style>
    <style name="IconButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">#FFFFFF</item>
    </style>
    <style name="TextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
    </style>
</resources>
