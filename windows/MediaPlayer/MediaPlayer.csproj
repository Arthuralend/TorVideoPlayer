<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MediaPlayer</AssemblyName>
    <RootNamespace>MediaPlayerApp</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.2.1</Version>
    <Product>MediaPlayer</Product>
    <Description>Torrent streaming video player based on VLC with dual subtitles</Description>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Only the 64-bit VLC libraries and Russian/English resources. -->
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.21" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="icon.png" />
    <None Include="app.ico" />
    <!-- Built by scripts/build-engine-windows.sh / CI -->
    <None Include="..\..\build\engine-windows\torengine.exe" Link="torengine.exe"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          Condition="Exists('..\..\build\engine-windows\torengine.exe')" />
  </ItemGroup>

</Project>
